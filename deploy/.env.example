# 生产环境变量（install.sh 会自动生成；手工部署时复制为 .env，权限 600）

# ---- 数据库 ----
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=sparrow
TZ=Asia/Shanghai

# ---- 应用 ----
# 加密节点私钥 / 插件密钥 / 2FA 密钥；生成：openssl rand -hex 32
# 一旦设置不要更换，否则已加密的节点密钥无法解密（节点需要重新注册）
MASTER_KEY=
# 站点对外地址（订阅链接、支付回调用）
NEXT_PUBLIC_SITE_URL=https://panel.example.com
# 初始化令牌：/setup 页面要填同一个值
SETUP_TOKEN=

# ---- 反向代理（caddy 容器）----
# 有域名：panel.example.com（自动申请 Let's Encrypt 证书）
# 无域名/内网：:80（纯 HTTP）
SITE_DOMAIN=panel.example.com
# Let's Encrypt 通知邮箱（可选）
ACME_EMAIL=
