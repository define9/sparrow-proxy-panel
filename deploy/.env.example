# 生产环境变量（install.sh 会自动生成；手工部署时复制为 .env，权限 600）

# ---- 数据库 ----
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=sparrow
TZ=Asia/Shanghai

# ---- 应用 ----
# 加密节点私钥 / 插件密钥 / 2FA 密钥；生成：openssl rand -hex 32
# 一旦设置不要更换，否则已加密的节点密钥无法解密（节点需要重新注册）
MASTER_KEY=
# 站点对外地址（订阅链接、支付回调用）。IPv6 要带方括号：http://[240e::1]
# 必须是**对外可访问**的地址：用户浏览器访问的就是它。
SITE_URL=https://panel.example.com
# 初始化令牌：/setup 页面要填同一个值
SETUP_TOKEN=

# ---- 反向代理（caddy 容器）----
# 有域名：panel.example.com（自动申请 Let's Encrypt 证书）
# 无域名/内网：:80（纯 HTTP）
SITE_DOMAIN=panel.example.com
# Let's Encrypt 通知邮箱（可选）
ACME_EMAIL=

# ---- 可选 ----
# 会话 cookie 是否强制带 Secure。默认按 SITE_URL 是否 https 自动判断；
# 纯 HTTP 部署时务必保持自动（设 0 明确关闭），否则登录后立刻掉线。
# COOKIE_SECURE=1

# Agent 分发：面板只代理 GitHub Release，不存发布数据。留空用默认值。
# AGENT_RELEASE_REPO=define9/sparrow-proxy-panel
# AGENT_RELEASE_TTL=600
# GitHub 未认证限额 60 次/小时/IP（面板有 10 分钟缓存，一般够用）；撞限额时配这个。
# GITHUB_TOKEN=ghp_xxx
