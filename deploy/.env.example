# 生产环境变量（复制为 .env，权限 600，不要提交）
# docker compose 会自动读取同目录的 .env

# 数据库
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=改成强密码
POSTGRES_DB=sparrow
TZ=Asia/Shanghai

# 应用
# 加密节点私钥 / 插件密钥 / 2FA 密钥的主密钥；生成：openssl rand -hex 32
# 一旦设置后不要更换，否则已加密的节点密钥无法解密（节点需要重新注册）
MASTER_KEY=
# 站点对外地址，用于生成订阅链接与支付回调地址
NEXT_PUBLIC_SITE_URL=https://panel.example.com
# 初始化令牌：公网部署时建议设置，/setup 页面要填同一个值
SETUP_TOKEN=
