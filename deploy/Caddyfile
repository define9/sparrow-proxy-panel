# 由环境变量驱动（见 deploy/.env）
#   SITE_DOMAIN=panel.example.com → 自动申请证书走 HTTPS
#   SITE_DOMAIN=:80               → 纯 HTTP（无域名/内网测试）
# 两个变量都带默认值：环境变量为空时不会生成非法配置（这是之前重启循环的原因）

{
	# 必须非空：LET'S ENCRYPT 账号邮箱。compose 已兜底为 ops@example.com
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN::80} {
	encode zstd gzip

	# Next 产物带 hash，可长缓存
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 订阅输出由面板自己控制缓存
	@sub path /sub/*
	header @sub Cache-Control "private, max-age=60"

	reverse_proxy panel:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
