# 由环境变量驱动：SITE_DOMAIN / ACME_EMAIL（见 deploy/.env）
# SITE_DOMAIN=panel.example.com → 自动申请证书走 HTTPS
# SITE_DOMAIN=:80               → 纯 HTTP（无域名/内网测试用）

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Next 产物带 hash，可长缓存
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 订阅输出由面板自己控制缓存
	@sub path /sub/*
	header @sub Cache-Control "private, max-age=60"

	reverse_proxy panel:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
