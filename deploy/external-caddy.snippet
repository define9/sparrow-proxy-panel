# 机器上已有统一 Caddy 时，把这段加进你的 Caddyfile（/etc/caddy/Caddyfile）
# 面板容器只监听 127.0.0.1:3000，由这台 Caddy 负责 HTTPS 与证书
#
# 部署命令（不要内置 caddy）：
#   cd /opt/sparrow/app/deploy && sudo ./up.sh --no-caddy --domain panel.example.com

panel.example.com {
	encode zstd gzip

	# Next 产物带 hash，可长缓存
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 订阅输出由面板自己控制缓存
	@sub path /sub/*
	header @sub Cache-Control "private, max-age=60"

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/panel.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}

# 如果 3000 端口被占用，在 deploy/.env 里设置 PANEL_PORT=13000，
# 并把上面的 127.0.0.1:3000 同步改成 127.0.0.1:13000
