# ── 数据库 ──
# drizzle-kit（迁移 / seed）使用 DATABASE_URL
DATABASE_URL=postgresql://sparrow:dev@localhost:5432/sparrow
# Nitro 运行时使用 NUXT_ 前缀的变量（容器部署时注入这一个即可）
NUXT_DATABASE_URL=postgresql://sparrow:dev@localhost:5432/sparrow
NUXT_DB_POOL_MAX=10

# ── 安全 ──
# 会话加密密钥（nuxt-auth-utils 要求至少 32 字符，否则启动/登录会报
# "Password string too short (min 32 characters required)"）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD={{SECRET_kqs5sx1m}}
# 主加密密钥（节点私钥、插件密钥、2FA 密钥），32 字节
NUXT_MASTER_KEY=change-me-to-a-random-32-byte-key!!

# ── 站点信息（公开）──
NUXT_PUBLIC_SITE_NAME=Sparrow 代理面板
NUXT_PUBLIC_SITE_URL=http://localhost:3000
