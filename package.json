{
  "name": "sparrow-proxy-panel",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter panel dev",
    "build": "pnpm --filter panel build",
    "start": "pnpm --filter panel start",
    "lint": "pnpm --filter panel lint",
    "typecheck": "pnpm --filter panel typecheck",
    "agent:build": "cd src/agent && make build",
    "agent:test": "cd src/agent && go test ./...",
    "agent:lint": "cd src/agent && make lint"
  }
}
